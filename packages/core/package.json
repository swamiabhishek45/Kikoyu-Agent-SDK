{
  "name": "@kikoyu/core",
  "version": "0.1.12",
  "description": "An Agent SDK for building AI agent workflows with type-safe tools, memory, execution loops, and streaming capabilities.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swamiabhishek45/Kikoyu-Agent-SDK.git"
  },
  "homepage": "https://github.com/swamiabhishek45/Kikoyu-Agent-SDK#readme",
  "bugs": {
    "url": "https://github.com/swamiabhishek45/Kikoyu-Agent-SDK/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^4.52.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
